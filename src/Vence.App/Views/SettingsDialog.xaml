<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Vence.App.Views.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="设置"
    PrimaryButtonText="保存设置"
    CloseButtonText="取消"
    DefaultButton="Primary"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <SolidColorBrush x:Key="VenceSurfaceBrush" Color="#FFFCF7EE" />
        <SolidColorBrush x:Key="VencePanelBrush" Color="#FFF8F2E8" />
        <SolidColorBrush x:Key="VenceInkBrush" Color="#FF252A26" />
        <SolidColorBrush x:Key="VenceMutedBrush" Color="#FF6F746F" />
        <SolidColorBrush x:Key="VenceLineBrush" Color="#FFE3DACB" />
        <SolidColorBrush x:Key="VenceAccentBrush" Color="#FF355B4B" />
        <SolidColorBrush x:Key="VenceSelectedBrush" Color="#FFE8EEF0" />
    </ContentDialog.Resources>

    <Grid
        MinWidth="400"
        MaxWidth="460"
        RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Width="44"
                Height="44"
                Background="{StaticResource VenceSelectedBrush}"
                BorderBrush="{StaticResource VenceLineBrush}"
                BorderThickness="1"
                CornerRadius="22">
                <FontIcon
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="18"
                    Foreground="{StaticResource VenceAccentBrush}"
                    Glyph="&#xE946;" />
            </Border>

            <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource VenceInkBrush}"
                    Text="AI 辅助设置" />
                <TextBlock
                    x:Name="ProviderSummaryText"
                    FontSize="13"
                    Foreground="{StaticResource VenceMutedBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <Border
            Grid.Row="1"
            Padding="16"
            Background="{StaticResource VencePanelBrush}"
            BorderBrush="{StaticResource VenceLineBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource VenceInkBrush}"
                    Text="提供商" />

                <ComboBox
                    x:Name="ProviderComboBox"
                    Grid.Row="1"
                    MinHeight="36"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="AI 提供商"
                    PointerWheelChanged="OnProviderComboBoxPointerWheelChanged"
                    SelectedIndex="0">
                    <ComboBoxItem Content="OpenAI 兼容接口" />
                    <ComboBoxItem Content="Ollama 本地模型" />
                </ComboBox>
            </Grid>
        </Border>

        <Border
            Grid.Row="2"
            Padding="16"
            Background="{StaticResource VencePanelBrush}"
            BorderBrush="{StaticResource VenceLineBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource VenceInkBrush}"
                    Text="连接参数" />

                <StackPanel
                    x:Name="ApiKeySection"
                    Grid.Row="1"
                    Spacing="6">
                    <TextBlock
                        FontSize="13"
                        Foreground="{StaticResource VenceInkBrush}"
                        Text="API Key" />
                    <PasswordBox
                        x:Name="ApiKeyBox"
                        MinHeight="36"
                        AutomationProperties.Name="OpenAI API Key"
                        PlaceholderText="sk-..." />
                    <TextBlock
                        FontSize="12"
                        Foreground="{StaticResource VenceMutedBrush}"
                        Text="密钥只保存在本机设置文件中，用于读者模式 AI 辅助。" />
                </StackPanel>

                <StackPanel Grid.Row="2" Spacing="6">
                    <TextBlock
                        FontSize="13"
                        Foreground="{StaticResource VenceInkBrush}"
                        Text="API 端点" />
                    <TextBox
                        x:Name="EndpointBox"
                        MinHeight="36"
                        AutomationProperties.Name="API 端点"
                        Header=""
                        PlaceholderText="留空使用默认端点" />
                    <TextBlock
                        x:Name="EndpointHintText"
                        FontSize="12"
                        Foreground="{StaticResource VenceMutedBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Row="3" Spacing="6">
                    <TextBlock
                        FontSize="13"
                        Foreground="{StaticResource VenceInkBrush}"
                        Text="模型" />
                    <TextBox
                        x:Name="ModelIdBox"
                        MinHeight="36"
                        AutomationProperties.Name="模型名称"
                        PlaceholderText="gpt-4o-mini" />
                    <TextBlock
                        x:Name="ModelHintText"
                        FontSize="12"
                        Foreground="{StaticResource VenceMutedBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <InfoBar
            x:Name="ConfigStatusInfoBar"
            Grid.Row="3"
            IsOpen="True"
            IsClosable="False"
            Severity="Warning"
            Title="未配置"
            Message="请填写 AI 配置后保存，读者模式 AI 功能才能使用。" />
    </Grid>
</ContentDialog>
